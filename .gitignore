# Nothing is built here: the repo root is what Cloudflare Pages serves.

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Test panoramas. Client site imagery must not end up in this repo.
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.dng

# The social card is generated from og.svg and committed, since the deploy has
# no build step. Regenerate with scripts/render-og.mjs.
!og.png

# Wrangler writes account id and account name here when any wrangler
# command runs in this directory. Never commit it: this repo is public.
.wrangler/
